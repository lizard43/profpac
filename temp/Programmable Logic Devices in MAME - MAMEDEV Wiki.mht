.mw-message-box { background-color: rgb(238, 238, 238); color: rgb(0, 0, 0); box-sizing: border-box; margin-bottom: 16px; border: 1px solid rgb(170, 170, 170); padding: 12px 24px; overflow-wrap: break-word; overflow: hidden; }

