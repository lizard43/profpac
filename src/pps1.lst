  44:	007B          	PORT_PATTERN_SKIP       equ     $7B
  45:	007C          	PORT_PATTERN_DEST_LO    equ     $7C
  46:	007D          	PORT_PATTERN_DEST_HI    equ     $7D
  47:	007E          	PORT_PATTERN_LENGTH     equ     $7E
