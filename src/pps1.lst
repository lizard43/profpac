**** src/pps1.asm ****
   7:			
   8:	0000          	        org     $0000
   9:			
  10:	0000          	RESET_ENTRY:
  11:	0000  00      	        nop                             ; $0000
  12:	0001  00      	        nop                             ; $0001
  13:	0002  F3      	        di                              ; $0002
  14:	0003  C31500  	        jp COLD_START                   ; $0003
  15:	0006  2500    	        db      $25,$00                                                         ; $0006
  16:	0008          	TERSE_COLON_ENTRY:
  17:			        ; RST $08 leaves the nested body address on SP. Preserve the caller's
  18:			        ; threaded IP on the downward-growing IX control stack, load the new
  19:			        ; IP into BC, and resume through the cached dispatcher in IY.
  20:	0008  DD2B    	        dec ix                          ; $0008
  21:	000A  DD7000  	        ld (ix+0),b                     ; $000A
  22:	000D  DD2B    	        dec ix                          ; $000D
  23:	000F  DD7100  	        ld (ix+0),c                     ; $000F
  24:	0012  C1      	        pop bc                          ; $0012
  25:	0013  FDE9    	        jp (iy)                         ; $0013
  26:	0015          	COLD_START:
  27:	0015  F3      	        di                              ; $0015
  28:	0016  ED46    	        im 0                            ; $0016
  29:	0018  01F400  	        ld bc,$00f4                     ; $0018
  30:	001B          	L001B:
  31:	001B  ED41    	        out (c),b                       ; $001B
  32:	001D  79      	        ld a,c                          ; $001D
  33:	001E  D601    	        sub $01                         ; $001E
  34:	0020  4F      	        ld c,a                          ; $0020
  35:	0021  D21B00  	        jp nc,L001B                     ; $0021
  36:	0024  3E01    	        ld a,$01                        ; $0024
  37:	0026  D308    	        out (PORT_VIDEO_MODE),a         ; $0026
  38:	0028  011500  	        ld bc,$0015                     ; $0028
  39:	002B  ED78    	        in a,(c)                        ; $002B
