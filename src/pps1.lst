   1:			; Professor Pac-Man program ROM PPS1
   2:			; Fixed CPU address $0000-$1FFF
   3:			; Native Z80 uses mnemonics; TERSE threads use structured tokens and operands.
   4:			; Graphics and unclassified data retain addressed DB definitions.
   5:			
   6:			        include "src/profpac_common.include"
**** src/profpac_common.include ****
   1:			; Professor Pac-Man shared hardware definitions
   2:			;
   3:			; Included by every physical program-ROM assembly unit.  Hardware addresses
   4:			; live here so fixed and banked ROM sources use one consistent board ABI.
   5:			
   6:	4000          	SCREEN_WINDOW           equ     $4000
   7:	8000          	BANKED_PROGRAM_WINDOW   equ     $8000
   8:	C000          	FIXED_HIGH_ROM           equ     $C000
   9:	E000          	BATTERY_RAM              equ     $E000
  10:	E800          	WORK_RAM                 equ     $E800
  11:			
  12:			; Astrocade and Professor Pac-Man board I/O ports
  13:	00F3          	PORT_BANK_SELECT        equ     $F3
  14:			
  15:			; Port $F3 bank-selector values.  Bits 5-6 always select the Super Game
  16:			; configuration; bit 7 replaces the $4000-$7FFF read window with one of forty
  17:			; 16 KB question-EPROM banks.  The production question board uses base $80.
  18:	0000          	BANK_CONFIG_0           equ     $00
  19:	0020          	BANK_CONFIG_1           equ     $20
  20:	0040          	BANK_CONFIG_2           equ     $40
  21:	0060          	BANK_CONFIG_3           equ     $60
  22:	0060          	BANK_CONFIG_MASK        equ     $60
  23:	0080          	QUESTION_BANK_BASE      equ     $80
  24:	0028          	QUESTION_BANK_COUNT     equ     $28
  25:	00A7          	QUESTION_BANK_LAST      equ     $A7
  26:	000E          	POPULATED_QUESTION_BANKS equ    $0E
  27:	0008          	PORT_VIDEO_MODE         equ     $08
  28:	0009          	PORT_VIDEO_COLOR        equ     $09
  29:	000A          	PORT_VIDEO_VERTICAL     equ     $0A
  30:	000B          	PORT_VIDEO_STATUS       equ     $0B
  31:	000C          	PORT_VIDEO_CONFIG       equ     $0C
  32:	000D          	PORT_VIDEO_HORIZON      equ     $0D
  33:	000E          	PORT_INTERRUPT_VECTOR   equ     $0E
  34:	000F          	PORT_INTERRUPT_ENABLE   equ     $0F
  35:	0010          	PORT_INPUT_PRIMARY      equ     $10
  36:	0011          	PORT_INPUT_BUTTONS      equ     $11
  37:	0013          	PORT_INPUT_DIP          equ     $13
  38:	0010          	PORT_SOUND_MASTER       equ     $10
